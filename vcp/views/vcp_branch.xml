<odoo>
    <record model="ir.ui.view" id="vcp_branch_form_view">
        <field name="model">vcp.branch</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_branch_list_view">
        <field name="model">vcp.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>
</odoo>
