<odoo>
    <record model="ir.ui.view" id="vcp_request_form_view">
        <field name="model">vcp.request</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Merged"
                        bg_color="bg-success"
                        invisible="not is_merged"
                    />
                    <widget
                        name="web_ribbon"
                        title="Closed"
                        bg_color="bg-danger"
                        invisible="is_merged or not closed_at"
                    />
                    <field name="is_merged" invisible="1" />
                    <field name="closed_at" invisible="1" />
                    <group>
                        <field name="external_id" />
                        <field name="url" widget="url" />
                        <field name="organization_id" />
                        <field name="repository_id" />
                        <field name="branch_id" />
                        <field name="number" />
                        <field name="name" />
                        <field name="state" />
                        <field name="partner_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_request_search_view">
        <field name="model">vcp.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="organization_id" />
                <field name="repository_id" />
                <field name="branch_id" />
                <field name="number" />
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_request_tree_view">
        <field name="model">vcp.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="organization_id" />
                <field name="repository_id" />
                <field name="branch_id" />
                <field name="number" />
                <field name="name" />
                <field name="url" widget="url" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_request_act_window">
        <field name="name">Requests</field>
        <field name="path">vcp-requests</field>
        <field name="res_model">vcp.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.actions.act_window" id="vcp_request_repository_act_window">
        <field name="name">Requests</field>
        <field name="path">vcp-platform-requests</field>
        <field name="res_model">vcp.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("repository_id", "=", active_id)]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="vcp_request_menu">
        <field name="name">Requests</field>
        <field name="parent_id" ref="vcp_main_menu" />
        <field name="action" ref="vcp_request_act_window" />
        <field name="sequence" eval="20" />
    </record>
</odoo>
